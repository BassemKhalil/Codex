[Unit]
Description=Polymarket Weather Bot - Trading Loop
After=network.target

[Service]
Type=simple
User=polymarket
WorkingDirectory=/opt/polymarket-bot
EnvironmentFile=/opt/polymarket-bot/.env
ExecStart=/opt/polymarket-bot/venv/bin/python run_bot.py run --interval 360
Restart=always
RestartSec=30

[Install]
WantedBy=multi-user.target
