[Unit]
Description=Polymarket Weather Bot - Web Dashboard
After=network.target

[Service]
Type=simple
User=polymarket
WorkingDirectory=/opt/polymarket-bot
EnvironmentFile=/opt/polymarket-bot/.env
ExecStart=/opt/polymarket-bot/venv/bin/gunicorn -w 2 -b 0.0.0.0:5000 polymarket_bot.dashboard:app
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
